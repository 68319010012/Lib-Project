# Secrets — must never end up baked into an image layer (images can be pulled/
# inspected by anyone with registry access, unlike a local .env file).
.env
.env.*
!.env.production.example

# Local dev virtualenv — huge, OS/Python-build-specific, and reinstalled from
# requirements.txt inside the image anyway (see Dockerfile).
venv/

# Real student roster (PII) — never committed to git either (see project docs);
# doubly make sure it can't slip into a Docker image via local build context.
Student.xlsx

# Stale local archive mentioned in project docs as safe to delete; never
# intended to ship.
BackEnd.zip

# Python bytecode caches — regenerated at runtime, not needed in the image.
__pycache__/
*.pyc
.pytest_cache/

# Version control metadata — not needed at runtime and can be large.
.git/
.gitignore

# Editor/assistant-local config — irrelevant to the running app.
.claude/
.vscode/

# Legacy upload directory (unused since registration no longer takes ID
# photos — see PROJECT_CONTEXT.md "Registration simplified to fully automatic").
uploads/

# Project docs — not needed for the app to run; keeps the image focused on
# code. (Remove specific lines here if a doc ever needs to ship, e.g. for an
# in-app "about" page — none currently reference these files.)
*.md
