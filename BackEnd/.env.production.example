# Template for the .env used in production (Coolify). Copy the field names
# below into Coolify's Environment Variables UI for this service — do NOT
# commit a real filled-in .env anywhere (see .gitignore/.dockerignore).
# Every field here is read by db.py / app.py exactly like the dev .env from
# NEW_COMPUTER_SETUP.md; only the VALUES differ in production, as noted below.

# --- Database ---
# In dev this was XAMPP's MySQL on the same machine (DB_HOST=localhost,
# DB_USER=root, DB_PASSWORD=<empty>). In Coolify, MySQL runs as its own
# container/service, so:
#   - DB_HOST must be that MySQL service's Coolify-internal hostname (NOT
#     localhost/127.0.0.1 — the Flask app and MySQL are separate containers).
#   - DB_USER/DB_PASSWORD must be a real, non-root MySQL user Coolify
#     generates (or one you create) — never reuse the dev "root / no password"
#     combination.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=library_checkin

# --- Flask ---
# MUST be a freshly generated random value in production — never reuse the
# dev secret key or any value that has ever been typed in chat/committed
# anywhere. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# MUST be "false" in production. Flask's debug mode exposes an interactive
# in-browser debugger/stack trace on unhandled errors (arbitrary code
# execution if it's ever reachable from outside) and enables the
# auto-reloader, neither of which belong in production. Dev defaults to
# "true" when this var is absent (see app.py) — production must set it
# explicitly.
FLASK_DEBUG=false

# --- App behavior (same meaning as dev; only worth double-checking the value
# is still correct for how the college actually wants production to behave) ---
# Optional — defaults to 17:00 if unset, same as dev.
LIBRARY_CLOSING_TIME=17:00
