BackEnd/.claude/settings.local.json

# Real student personal data — never commit (names + student IDs of real people)
BackEnd/Student.xlsx
backend-php/Student.xlsx

# Python
BackEnd/venv/
BackEnd/__pycache__/
BackEnd/**/__pycache__/
*.pyc
BackEnd/.pytest_cache/

# Uploaded files (user-generated at runtime, not source)
BackEnd/uploads/

# PHP (backend-php) — Composer is scoped to scripts/import_students.php only,
# see backend-php/composer.json
backend-php/vendor/
backend-php/composer.phar

# Generated project manual — embeds FTP host and production DB name in its
# deployment chapter, so it must never reach GitHub. The manual itself
# teaches "git add .", which would otherwise sweep this straight up.
NTC_Library_*.pdf

# Demo-video media — ตัวไฟล์เสียง/วิดีโอไม่เก็บใน git
# ของจริงอยู่บน Google Drive แล้ว (วิดิโอการสาธิตการใช้งานเว็บแอปพลิเคชัน.mp4)
# เก็บซ้ำใน repo ทำให้ clone ช้าโดยไม่ได้อะไรเพิ่ม และ deploy ก็ไม่เคยอัปโฟลเดอร์นี้
# สคริปต์ (.js) สคริปต์พากย์ (.md) และซับ (.srt) ยังเก็บตามปกติ เพราะเป็นซอร์ส
demo-video/output/
demo-video/recordings/
demo-video/voice/

# เราเตอร์สำหรับ php -S เท่านั้น ของจริงใช้ Apache + .htaccess
# ห้ามขึ้นเว็บจริง: deploy.yml อัปทุกไฟล์ที่เปลี่ยนใต้ public/
backend-php/public/_devrouter.php
