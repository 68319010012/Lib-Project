DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=library_checkin

# dev | prod — controls session cookie SameSite/Secure (see src/auth.php)
APP_ENV=dev

# exact React origin allowed via CORS (no wildcard — credentials require an exact match)
FRONTEND_ORIGIN=http://localhost:5173

# PHP timezone (must agree with the MySQL server's clock — see public/index.php)
APP_TIMEZONE=Asia/Bangkok

# library closing time, HH:MM (used by /checkin's planned-checkout logic)
LIBRARY_CLOSING_TIME=17:00
